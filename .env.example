# ─── Postgres ────────────────────────────────────────────────────────────────
# Host port 5433 avoids colliding with a local PostgreSQL install on 5432.
POSTGRES_USER=ekis
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=ekis
POSTGRES_HOST_PORT=5434

# Used by the Next.js app (Drizzle) from the HOST, so it points at the host port.
DATABASE_URL=postgresql://ekis:change-me-local-dev-only@localhost:5434/ekis

# ─── Services ────────────────────────────────────────────────────────────────
API_HOST_PORT=8010
EMBED_HOST_PORT=8001
RAG_API_URL=http://localhost:8010

# ─── LLM provider ────────────────────────────────────────────────────────────
# offline = no API key needed. Retrieval is fully real; generation is stubbed
# with deterministic responses that cite genuinely retrieved chunks.
# live     = real Claude calls. Requires ANTHROPIC_API_KEY.
LLM_MODE=offline
# Generation backend: offline | anthropic | gemini
# "offline" needs no key at all and still runs the entire retrieval half.
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=

# Gemini. Get a key at https://aistudio.google.com/apikey
# Used when LLM_PROVIDER=gemini, and by scripts/compare_providers.py.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Judge model. MUST differ from GEMINI_MODEL - a model may not grade itself.
GEMINI_JUDGE_MODEL=gemini-3.5-flash

# Model assignments. Never judge Opus output with Opus (self-preference bias).
MODEL_ANSWER=claude-opus-5
MODEL_REWRITE=claude-haiku-4-5
MODEL_DECOMPOSE=claude-haiku-4-5
MODEL_VERIFY=claude-sonnet-5
ANSWER_EFFORT=high

# ─── Local models ────────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DIM=1024

# ─── Retrieval tuning (every one of these is measured, not guessed) ──────────
RRF_K=60
LANE_K=100
FUSE_OUT_N=60
RERANK_TOP_N=12
RERANK_SCORE_FLOOR=0.25
RERANK_RELATIVE_FLOOR=0.50
HNSW_EF_SEARCH=100
MAX_CONTEXT_TOKENS=60000

# ─── Ingestion ───────────────────────────────────────────────────────────────
OCR_ENGINE=paddle          # paddle | tesseract
MAX_UPLOAD_BYTES=52428800  # 50 MB — what makes streaming-through-Next safe
CHUNK_TARGET_TOKENS=400
CHUNK_MIN_TOKENS=128
CHUNK_MAX_TOKENS=512
CHUNK_BREAKPOINT_PERCENTILE=95

# ─── Auth (Next.js) ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Shared secret for the Next.js -> FastAPI service token. MUST match on both sides.
# Generate separately from AUTH_SECRET; do not reuse the same value.
RAG_SERVICE_SECRET=
