# ─── Postgres ────────────────────────────────────────────────────────────────
# Host port 5433 avoids colliding with a local PostgreSQL install on 5432.
POSTGRES_USER=ekis
POSTGRES_PASSWORD=ekis_dev_password
POSTGRES_DB=ekis
POSTGRES_HOST_PORT=5434

# Used by the Next.js app (Drizzle) from the HOST, so it points at the host port.
DATABASE_URL=postgresql://ekis:ekis_dev_password@localhost:5434/ekis

# ─── Services ────────────────────────────────────────────────────────────────
API_HOST_PORT=8010
EMBED_HOST_PORT=8001
RAG_API_URL=http://localhost:8010

# ─── LLM provider ────────────────────────────────────────────────────────────
# offline = no API key needed. Retrieval is fully real; generation is stubbed
# with deterministic responses that cite genuinely retrieved chunks.
# live     = real Claude calls. Requires ANTHROPIC_API_KEY.
LLM_MODE=offline
ANTHROPIC_API_KEY=

# Model assignments. Never judge Opus output with Opus (self-preference bias).
MODEL_ANSWER=claude-opus-5
MODEL_REWRITE=claude-haiku-4-5
MODEL_DECOMPOSE=claude-haiku-4-5
MODEL_VERIFY=claude-sonnet-5
ANSWER_EFFORT=high

# ─── Local models ────────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DIM=1024

# ─── Retrieval tuning (every one of these is measured, not guessed) ──────────
RRF_K=60
LANE_K=100
FUSE_OUT_N=60
RERANK_TOP_N=12
RERANK_SCORE_FLOOR=0.25
RERANK_RELATIVE_FLOOR=0.50
HNSW_EF_SEARCH=100
MAX_CONTEXT_TOKENS=60000

# ─── Ingestion ───────────────────────────────────────────────────────────────
OCR_ENGINE=paddle          # paddle | tesseract
MAX_UPLOAD_BYTES=52428800  # 50 MB — what makes streaming-through-Next safe
CHUNK_TARGET_TOKENS=400
CHUNK_MIN_TOKENS=128
CHUNK_MAX_TOKENS=512
CHUNK_BREAKPOINT_PERCENTILE=95

# ─── Auth (Next.js) ──────────────────────────────────────────────────────────
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Shared secret for the Next.js -> FastAPI service token. MUST match on both sides.
RAG_SERVICE_SECRET=change-me-openssl-rand-base64-32
